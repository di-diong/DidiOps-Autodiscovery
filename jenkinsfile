pipeline {
    agent any
    tools {
        terraform 'terraform'
    }
    parameters {
        choice(name: 'action', choices: ['apply', 'destroy'], description: 'Select the action to perform')
    }
    triggers {
        pollSCM('* * * * *') // Runs every minute
    }
    environment {
        SLACKCHANNEL = 'U0A89M467HA'
        SLACKCREDENTIALS = credentials('slack-cred')
        // Vault address (behind the ELB / Route53 record created by the jenkins/ stack)
        // and root token, read by the "vault" provider in provider.tf.
        VAULT_ADDR = 'https://vault.didiops.space'
        VAULT_TOKEN = credentials('vault-token')
        // New Relic creds for the nr_key/nr_acc_id/nr_license_key Terraform vars.
        // terraform.tfvars pins these to "" (tracked file, real values never
        // belong there), and tfvars precedence beats plain env vars, so they
        // must be passed as -var on each terraform command below, not just
        // exported into the environment.
        NR_KEY = credentials('nr_key')
        NR_ACC_ID = credentials('nr_acc_id')
        NR_LICENSE_KEY = credentials('nr_license_key')
    }
   
   stage('IAC Scan') {
    steps {
        sh '''
            set -e

            python3 -m venv .checkov-venv

            .checkov-venv/bin/python -m pip install --upgrade pip

            .checkov-venv/bin/python -m pip install checkov

            .checkov-venv/bin/checkov \
                -d . \
                -o cli \
                --output-file checkov-results.txt \
                --quiet
        '''
    }
}
        stage('Terraform format') {
            steps {
                sh 'terraform fmt --recursive'
            }
        }
        stage('Terraform validate') {
            steps {
                sh 'terraform validate'
            }
        }
        stage('Terraform plan') {
            steps {
                sh 'terraform plan -var "nr_key=$NR_KEY" -var "nr_acc_id=$NR_ACC_ID" -var "nr_license_key=$NR_LICENSE_KEY"'
            }
        }
        stage('Terraform action') {
            steps {
                script {
                    // Shell-level double quotes (not single) so bash actually expands
                    // $NR_KEY/$NR_ACC_ID/$NR_LICENSE_KEY from the environment - single
                    // quotes suppressed expansion and passed terraform the literal
                    // string "$NR_KEY" as the var value on every apply.
                    sh 'terraform ' + params.action + ' -auto-approve -var "nr_key=$NR_KEY" -var "nr_acc_id=$NR_ACC_ID" -var "nr_license_key=$NR_LICENSE_KEY"'
                }
            }
        }
    }
    post {
        always {
            script {
                slackSend(
                    channel: env.SLACKCHANNEL,
                    color: currentBuild.result == 'SUCCESS' ? 'good' : 'danger',
                    message: "Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL}) has been completed."
                )
            }
        }
        failure {
            slackSend(
                channel: env.SLACKCHANNEL,
                color: 'danger',
                message: "Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' has failed. Check console output at ${env.BUILD_URL}."
            )
        }
        success {
            slackSend(
                channel: env.SLACKCHANNEL,
                color: 'good',
                message: "Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' completed successfully. Check console output at ${env.BUILD_URL}."
            )
        }
    }
}
 