
pipeline {
    agent any

    tools {
        terraform 'terraform'
    }

    parameters {
        choice(
            name: 'action',
            choices: ['apply', 'destroy'],
            description: 'Select the Terraform action to perform'
        )
    }

    triggers {
        pollSCM('* * * * *')
    }

    environment {
        SLACKCHANNEL = 'U0A89M467HA'
        SLACKCREDENTIALS = credentials('slack-cred')

        VAULT_ADDR = 'https://vault.didiops.space'
        VAULT_TOKEN = credentials('vault-token')

        NR_KEY = credentials('nr_key')
        NR_ACC_ID = credentials('nr_acc_id')
        NR_LICENSE_KEY = credentials('nr_license_key')
    }

    stages {
        stage('IAC Scan') {
            steps {
                script {
                    sh '''
                        set -e

                        python3 -m venv .checkov-venv

                        .checkov-venv/bin/python -m pip install --upgrade pip

                        .checkov-venv/bin/python -m pip install checkov
                    '''

                    def checkovStatus = sh(
                        script: '''
                            .checkov-venv/bin/checkov \
                                -d . \
                                -o cli \
                                --quiet \
                                > checkov-results.txt 2>&1
                        ''',
                        returnStatus: true
                    )

                    archiveArtifacts(
                        artifacts: 'checkov-results.txt',
                        allowEmptyArchive: true
                    )

                    if (checkovStatus == 0) {
                        echo 'Checkov scan completed successfully.'
                    } else {
                        echo "Checkov returned exit code ${checkovStatus}. Review checkov-results.txt."
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init -reconfigure'
            }
        }

        stage('Terraform Format') {
            steps {
                sh 'terraform fmt --recursive'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    terraform plan \
                        -var="nr_key=$NR_KEY" \
                        -var="nr_acc_id=$NR_ACC_ID" \
                        -var="nr_license_key=$NR_LICENSE_KEY"
                '''
            }
        }

        stage('Terraform Action') {
            steps {
                script {
                    sh """
                        terraform ${params.action} \
                            -auto-approve \
                            -var="nr_key=$NR_KEY" \
                            -var="nr_acc_id=$NR_ACC_ID" \
                            -var="nr_license_key=$NR_LICENSE_KEY"
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                def buildColor =
                    currentBuild.currentResult == 'SUCCESS' ? 'good' : 'danger'

                slackSend(
                    channel: env.SLACKCHANNEL,
                    color: buildColor,
                    message: "Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL}) completed with status: ${currentBuild.currentResult}."
                )
            }
        }
    }
}
